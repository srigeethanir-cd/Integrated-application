APP_NAME=Test Case Accelerator
APP_VERSION=0.1.0
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/test_case_accelerator
REDIS_URL=redis://redis:6379/0
STAGE3_PROVIDER_CACHE_TTL_SECONDS=21600
STAGE3_ENRICHMENT_CACHE_TTL_SECONDS=21600
RUNTIME_PREPARATION_CACHE_TTL_SECONDS=43200
PIPELINE_CHECKPOINT_CACHE_TTL_SECONDS=43200
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=cerebras
PROVIDER_FAILOVER_THRESHOLD_SECONDS=30
MAX_PROVIDER_RETRIES=2
ENABLE_PROVIDER_FAILOVER=true
ENABLE_STAGE3_CACHE=true
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
TEST_VERIFICATION_MAX_PROVIDER_ATTEMPTS=3
TEST_VERIFICATION_RETRY_BASE_DELAY=0.25
TEST_VERIFICATION_MAX_RETRY_DELAY=2.0
TEST_VERIFICATION_RULE_CONFIDENCE_THRESHOLD=0.8
TEST_GENERATION_MAX_COMPLETION_TOKENS=16384
TEST_GENERATION_BATCH_MAX_FUNCTIONS=4
TEST_GENERATION_ESTIMATED_TOKENS_PER_CASE=650
TEST_GENERATION_SAFE_OUTPUT_TOKENS=12000
GROQ_MODEL_MAX_OUTPUT_TOKENS=65536
GROQ_TOKENS_PER_MINUTE=8000
GROQ_REQUESTS_PER_MINUTE=30
CEREBRAS_MODEL_MAX_OUTPUT_TOKENS=40960
CEREBRAS_TOKENS_PER_MINUTE=60000
CEREBRAS_REQUESTS_PER_MINUTE=30
LLM_TOKEN_PREFLIGHT_RESERVE=256
TEST_QUALITY_THRESHOLD=80
TEST_QUALITY_MAX_ITERATIONS=2
TEST_QUALITY_MINIMUM_IMPROVEMENT_DELTA=2
CODE_UNDERSTANDING_MAX_FILE_CHARACTERS=2500
CODE_UNDERSTANDING_MAX_TOTAL_CHARACTERS=10000
STORAGE_ROOT=storage/projects
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_ZIP_ENTRIES=10000
MAX_ZIP_TOTAL_UNCOMPRESSED_SIZE_BYTES=1073741824
MAX_ZIP_FILE_UNCOMPRESSED_SIZE_BYTES=104857600
MAX_ZIP_COMPRESSION_RATIO=100.0
SEMGREP_EXECUTABLE=semgrep
SEMGREP_CONFIG=p/default
SEMGREP_EXPLICIT_CONFIG=
SEMGREP_METRICS_ENABLED=false
SEMGREP_TIMEOUT_SECONDS=300
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
