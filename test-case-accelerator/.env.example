# Application Settings
APP_NAME=Test Case Accelerator
APP_VERSION=0.1.0
DEBUG=false

# Database & Cache Infrastructure
POSTGRES_DB=test_case_accelerator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/test_case_accelerator
REDIS_URL=redis://redis:6379/0

# Database Migrations on Container Startup (true/false)
RUN_DATABASE_MIGRATIONS=false

# LLM Provider API Credentials (Populate in your local .env file)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=cerebras

# Storage Configuration
STORAGE_ROOT=storage/projects

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80","http://localhost"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000
