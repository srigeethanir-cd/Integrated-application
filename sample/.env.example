# =====================================================================
# AI BA Accelerator — Environment Configuration Template
# =====================================================================

# Application General Settings
APP_NAME="AI BA Accelerator"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
API_VERSION=v1
SECRET_KEY=dev-secret-key-change-in-production-32bytes-min!

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./cd_se_accelerators.db
DB_ECHO=false

# LLM Provider Configuration
LLM_PROVIDER=groq  # Options: groq, openai, google, mock
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json # json, console
LOG_FILE_PATH=logs/app.log

# CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5000"]

# Directory Paths
WORKSPACE_ROOT=./workspace
OUTPUTS_ROOT=./outputs
CONFIGS_ROOT=./configs
