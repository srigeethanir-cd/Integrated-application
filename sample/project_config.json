{
  "project_name": "AI BA Accelerator",
  "version": "0.1.0",
  "description": "User Stories Code Generator and Architectural Scaffolder",
  "default_tech_stack": "Python FastAPI / React TypeScript / PostgreSQL",
  "paths": {
    "backend_dir": "backend",
    "frontend_dir": "frontend",
    "outputs_dir": "outputs",
    "workspace_dir": "workspace",
    "configs_dir": "configs",
    "logs_dir": "logs"
  },
  "agent_defaults": {
    "agent1": {
      "auto_approve_blueprint": false,
      "include_nfr_analysis": true,
      "max_features_per_module": 10
    },
    "agent2": {
      "sandbox_isolation": true,
      "auto_rollback_on_validation_failure": true,
      "default_test_framework": "pytest"
    }
  },
  "validation_rules": {
    "enforce_syntax_check": true,
    "enforce_ast_parsing": true,
    "enforce_security_scan": true,
    "enforce_api_contract_check": true
  }
}
