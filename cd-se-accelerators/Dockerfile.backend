FROM python:3.12-slim

# Install system dependencies, git, curl, and Node.js (needed for JS/TS AST parsers and Jest)
RUN apt-get update && \
    apt-get install -y git curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy requirements file
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy required backend resources
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini .
COPY scratch/ ./scratch/

# Create runtime directories
RUN mkdir -p brain generated_tests

# Install parser node dependencies
RUN if [ -d "/workspace/app/services/project_analyzer/parsers" ]; then \
        cd /workspace/app/services/project_analyzer/parsers && npm install --no-audit --no-fund; \
    fi

# Expose port
EXPOSE 8000

# Command to run FastAPI app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

