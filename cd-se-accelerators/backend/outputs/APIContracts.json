{
  "contracts": [
    {
      "endpoints": [
        {
          "description": "Retrieve list of authentication items",
          "method": "GET",
          "parameters": [
            {
              "in": "query",
              "name": "page",
              "required": false,
              "type": "integer"
            },
            {
              "in": "query",
              "name": "page_size",
              "required": false,
              "type": "integer"
            }
          ],
          "path": "/api/v1/authentication",
          "responses": {
            "200": {
              "description": "Success",
              "schema": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              }
            }
          }
        },
        {
          "description": "Create a new authentication item",
          "method": "POST",
          "path": "/api/v1/authentication",
          "request_body": {
            "required": true,
            "schema": {
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "responses": {
            "201": {
              "description": "Created",
              "schema": {
                "type": "object"
              }
            }
          }
        },
        {
          "description": "Retrieve a single authentication item by ID",
          "method": "GET",
          "parameters": [
            {
              "in": "path",
              "name": "id",
              "required": true,
              "type": "string"
            }
          ],
          "path": "/api/v1/authentication/{id}",
          "responses": {
            "200": {
              "description": "Success",
              "schema": {
                "type": "object"
              }
            },
            "404": {
              "description": "Not Found"
            }
          }
        }
      ],
      "module": "Authentication"
    }
  ],
  "project_name": "User Portal"
}
